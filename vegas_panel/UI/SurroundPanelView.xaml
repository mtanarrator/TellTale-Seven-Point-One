<UserControl x:Class="VegasSurround71.UI.SurroundPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#18181B"
             Foreground="#E6E6E6"
             FontFamily="Segoe UI"
             FontSize="12"
             MinWidth="980"
             MinHeight="680"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#18181B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#222226"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#1B1B1F"/>
        <SolidColorBrush x:Key="TrackBg" Color="#111114"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#323238"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A2A31"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentBright" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextDim" Color="#71717A"/>
        <SolidColorBrush x:Key="Success" Color="#22C55E"/>
        <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2F"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F1F24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBright}"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextMuted}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#222226" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="280" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#0E3A52"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#094771"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="{StaticResource TrackBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentBrush}"
                                                        Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextPrimary}"
                                                         Stroke="{StaticResource AccentBright}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16"
                                    Background="{StaticResource PanelBg}"
                                    BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="Check"
                                      Data="M 3 8 L 7 12 L 13 4"
                                      Stroke="{StaticResource AccentBright}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0E3A52"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource StudioCheckBox}"/>

        <Style x:Key="AutomationCheckBox" TargetType="CheckBox"
               BasedOn="{StaticResource StudioCheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="ArmBox" Width="14" Height="14"
                                    Background="{StaticResource PanelBg}"
                                    BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="7">
                                <Ellipse x:Name="ArmDot" Width="6" Height="6"
                                         Fill="{StaticResource Danger}"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArmDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ArmBox" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArmBox" Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveSyncCheckBox" TargetType="CheckBox"
               BasedOn="{StaticResource StudioCheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SyncPill"
                                Background="#1F242B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SyncDot" Width="7" Height="7"
                                         Fill="{StaticResource TextDim}"
                                         Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SyncPill" Property="Background" Value="#0E4A5F"/>
                                <Setter TargetName="SyncPill" Property="BorderBrush" Value="#2DD4BF"/>
                                <Setter TargetName="SyncDot" Property="Fill" Value="#2DD4BF"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SyncPill" Property="BorderBrush" Value="#2DD4BF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GainMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#22C55E" Offset="0.00"/>
                        <GradientStop Color="#84CC16" Offset="0.55"/>
                        <GradientStop Color="#F59E0B" Offset="0.82"/>
                        <GradientStop Color="#EF4444" Offset="1.00"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" SnapsToDevicePixels="True">
                            <Border Background="{StaticResource TrackBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    Margin="1"/>
                            <UniformGrid Columns="18" IsHitTestVisible="False"
                                         ClipToBounds="True">
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#18181B" BorderThickness="0,0,1,0"/>
                            </UniformGrid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Studio header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PanelTitleText"
                               Text="TellTale 7-Point-One"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border x:Name="BusStatusPill" Style="{StaticResource Pill}"
                            Margin="14,0,0,0"
                            ToolTip="Canonical 7.1 audio bus topology">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BusStatusDot" Width="7" Height="7"
                                     Fill="{StaticResource TextDim}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock x:Name="BusStatusText" Text="Busses 0/8"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BusModePill" Style="{StaticResource Pill}"
                            Margin="6,0,0,0"
                            ToolTip="VEGAS master bus mode">
                        <TextBlock x:Name="BusModeText" Text="Bus mode —"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                    <TextBlock x:Name="PendingStatusText" Margin="12,0,0,0"
                               Foreground="{StaticResource Warning}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Text="PENDING COMMIT"/>
                    <TextBlock x:Name="LiveStatusText" Margin="10,0,0,0"
                               Foreground="#2DD4BF" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Text="LIVE SYNC"/>
                </StackPanel>
                <Button x:Name="NativeInfoButton" Grid.Column="1"
                        Content="?" Style="{StaticResource IconButton}"
                        Margin="0" FontSize="12"
                        Click="OnNativeInfoClicked"
                        ToolTip="DLL / ABI details"/>
                <Popup x:Name="NativeInfoPopup" Grid.Column="1"
                       PlacementTarget="{Binding ElementName=NativeInfoButton}"
                       Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#1B1B1F" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8"
                            Margin="0,6,0,0" MaxWidth="360">
                        <TextBlock x:Name="NativeInfoText"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Radar soundstage + segmented gain meters -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="RoomCanvas" ClipToBounds="True"
                            Background="#141417"
                            MouseLeftButtonDown="OnRoomMouseDown"
                            MouseMove="OnRoomMouseMove"
                            MouseLeftButtonUp="OnRoomMouseUp"
                            LostMouseCapture="OnRoomLostMouseCapture"
                            SizeChanged="OnRoomSizeChanged"/>
                    <Border Background="#CC18181B" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="7,2" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="SOUNDSTAGE" Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="10">
                        <Button Content="↶" Style="{StaticResource IconButton}"
                                Click="OnPanelUndoClicked"
                                ToolTip="Undo last panel pan"/>
                        <Button Content="↺" Style="{StaticResource IconButton}"
                                Margin="0" Click="OnResetPuckClicked"
                                ToolTip="Reset puck to initial position"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}"
                    Margin="8,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CHANNEL"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Column="2" Text="dB"
                                   Style="{StaticResource SectionLabel}"
                                   TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="LIN"
                                   Style="{StaticResource SectionLabel}"
                                   TextAlignment="Right"/>
                    </Grid>
                    <StackPanel x:Name="MeterStack"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Track routing / pan controls / settings -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="TRACK ROUTING" Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,7"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Track" Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" x:Name="TrackCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,7,0"
                              SelectionChanged="OnTrackSelectionChanged"/>
                    <Button Grid.Column="2" Content="Refresh Tracks"
                            Click="OnRefreshTracksClicked" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="Setup 7.1 Busses"
                            Click="OnInitializeBussesClicked" Margin="0"/>
                </Grid>

                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="LFE Send" Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <Slider x:Name="LfeSlider" Width="150" Minimum="0" Maximum="1"
                            Value="0.25" TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OnLfeChanged"
                            PreviewMouseLeftButtonDown="OnSliderPressed"
                            Margin="0,0,4,0"/>
                    <TextBlock x:Name="LfeValueText" Width="42"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentBright}"
                               Margin="0,0,16,0"/>

                    <TextBlock Text="Spread" Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <Slider x:Name="SpreadSlider" Width="150" Minimum="0" Maximum="1"
                            Value="0.10" TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OnSpreadChanged"
                            PreviewMouseLeftButtonDown="OnSliderPressed"
                            Margin="0,0,4,0"/>
                    <TextBlock x:Name="SpreadValueText" Width="42"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentBright}"
                               Margin="0,0,16,0"/>

                    <CheckBox x:Name="KeyframeToggle" Content="Record Keyframes"
                              Style="{StaticResource AutomationCheckBox}"
                              ToolTip="Write send automation keyframes at the VEGAS playhead"
                              Margin="0,0,14,0"/>
                    <CheckBox x:Name="LivePanToggle" Content="Live Mixer Sync"
                              Style="{StaticResource LiveSyncCheckBox}"
                              IsChecked="True" Margin="0,0,14,0"
                              ToolTip="Stream gain changes to VEGAS Mixing Console in real time during playback"/>
                    <Button Content="Apply to Track" Click="OnApplyClicked"
                            Margin="0,0,6,0"
                            ToolTip="Commit the current puck, LFE, and spread state to the selected track now"/>
                    <Button Content="Reset Puck Position"
                            Click="OnResetPuckClicked" Margin="0,0,6,0"
                            ToolTip="Reset the puck to its initial position"/>
                    <Button Content="Reset Track Keyframes"
                            Click="OnResetTrackKeyframesClicked" Margin="0,0,6,0"
                            ToolTip="Clear 7.1 send automation from the selected track"/>
                    <Button Content="Reset All"
                            Click="OnResetAllClicked" Margin="0"
                            Background="#3A1515" BorderBrush="#EF4444"
                            Foreground="#FCA5A5"
                            ToolTip="Reset the panel to factory defaults and clear all progress"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Export -->
        <Border Grid.Row="3" Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EXPORT 7.1 MASTER"
                               Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="ReadinessBadgeBorder"
                            Background="#12351F" BorderBrush="#22C55E"
                            BorderThickness="1" CornerRadius="10"
                            Padding="9,2" VerticalAlignment="Center"
                            ToolTip="E-AC-3 presets produce a 5.1 compatibility downmix using FFmpeg's eac3 encoder. True 7.1 E-AC-3 requires a licensed Dolby encoder; verify your FFmpeg build and Dolby patent licensing for distribution.">
                        <TextBlock x:Name="ReadinessBadgeText" Text="Ready"
                                   Foreground="#86EFAC" FontWeight="SemiBold"
                                   FontSize="11"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBox Grid.Column="1" x:Name="OutputPathBox" Height="27"
                             Margin="0,0,7,0"/>
                    <Button Grid.Column="2" Content="Browse…"
                            Click="OnBrowseOutputClicked" Margin="0"/>
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Delivery"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" x:Name="DeliveryPresetCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="Video Template"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="3" x:Name="VideoTemplateCombo"
                              Style="{StaticResource DarkComboBox}"/>
                </Grid>

                <WrapPanel Margin="0,0,0,7">
                    <CheckBox x:Name="RenderLoopOnlyCheck"
                              Content="Render Loop Region Only (In / Out)"
                              Style="{StaticResource StudioCheckBox}"
                              Checked="OnRenderLoopChanged"
                              Unchecked="OnRenderLoopChanged"
                              ToolTip="Render only the VEGAS In/Out loop region on both the video and 8-channel audio passes"
                              Margin="0,0,14,0"/>
                    <TextBlock x:Name="LoopRangeText" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Text="No loop region set"/>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock Text="Codec" Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="CodecCombo" Width="200" Margin="0,0,14,0"
                              Style="{StaticResource DarkComboBox}"/>
                    <CheckBox x:Name="LfeLowpassCheck" Content="120 Hz LFE Low-Pass"
                              Style="{StaticResource StudioCheckBox}"
                              IsChecked="True" Margin="0,0,14,0"/>
                    <Button x:Name="RenderButton" Content="Export 7.1 Master"
                            Click="OnRenderClicked" Padding="14,5"
                            FontWeight="SemiBold" Margin="0"/>
                </WrapPanel>

                <TextBlock x:Name="RenderStatusText" Margin="0,7,0,0"
                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Compact status footer + collapsible diagnostic drawer -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Height="28" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusFooterText"
                               Text="Ready" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="Consolas" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" x:Name="LogToggleButton"
                            Content="▲ Diagnostic"
                            Style="{StaticResource FooterButton}"
                            Click="OnToggleLogClicked"
                            ToolTip="Expand or collapse the full diagnostic transcript"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="LogDrawer" Height="150"
                    Background="#141417" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,4,0,0" Visibility="Collapsed">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#141417" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
