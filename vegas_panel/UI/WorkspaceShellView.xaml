<UserControl x:Class="VegasSurround71.UI.WorkspaceShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#18181B"
             Foreground="#E6E6E6"
             FontFamily="Segoe UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#18181B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#222226"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#1B1B1F"/>
        <SolidColorBrush x:Key="TrackBg" Color="#111114"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#323238"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A2A31"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentBright" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextDim" Color="#71717A"/>
        <SolidColorBrush x:Key="Success" Color="#22C55E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="14,4"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#2A2A2F"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#094771"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Studio NLE workspace header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="WORKSPACE"
                           Foreground="{StaticResource TextDim}"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Background="{StaticResource TrackBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="2"
                        Margin="10,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Workspace71Button"
                                     GroupName="WorkspaceKind"
                                     Content="7.1 Panner"
                                     IsChecked="True"
                                     Checked="OnWorkspaceChecked"
                                     Style="{StaticResource SegmentedRadio}"/>
                        <RadioButton x:Name="WorkspaceHoaButton"
                                     GroupName="WorkspaceKind"
                                     Content="HOA / 3D Spatial"
                                     Checked="OnWorkspaceChecked"
                                     Style="{StaticResource SegmentedRadio}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Background="#3A2A0A"
                            BorderBrush="#B45309"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="7,2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Experimental beta build. Interfaces, state files, and exports may change without notice.">
                        <TextBlock Text="EXPERIMENTAL"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#FCD34D"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="WorkspaceDot" Width="7" Height="7"
                             Fill="{StaticResource AccentBright}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="WorkspaceStatusText"
                               Text="7.1 Panner"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBright}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <TextBlock x:Name="ProjectIdentityText"
                               Text="No project"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cached workspace instances; switching only toggles visibility. -->
        <Grid Grid.Row="1" x:Name="WorkspaceHost"
              Background="{StaticResource WindowBg}"/>
    </Grid>
</UserControl>
