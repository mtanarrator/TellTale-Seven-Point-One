<UserControl x:Class="VegasSurround71.UI.HoaSpatialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#18181B"
             Foreground="#E6E6E6"
             FontFamily="Segoe UI"
             FontSize="12"
             MinWidth="980"
             MinHeight="680"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#18181B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#222226"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#1B1B1F"/>
        <SolidColorBrush x:Key="TrackBg" Color="#111114"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#323238"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A2A31"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentBright" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextDim" Color="#71717A"/>
        <SolidColorBrush x:Key="Success" Color="#22C55E"/>
        <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2F"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F1F24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextMuted}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#222226" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="280" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#0E3A52"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#094771"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBright}"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="{StaticResource TrackBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentBrush}"
                                                        Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextPrimary}"
                                                         Stroke="{StaticResource AccentBright}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoaSegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8,3"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#2A2A2F"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#094771"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GainMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#22C55E" Offset="0.00"/>
                        <GradientStop Color="#84CC16" Offset="0.60"/>
                        <GradientStop Color="#F59E0B" Offset="0.84"/>
                        <GradientStop Color="#EF4444" Offset="1.00"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{StaticResource TrackBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    Margin="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HOA header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="HOA / 3D Spatial" FontSize="16"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border x:Name="OrderPill" Style="{StaticResource Pill}"
                            Margin="14,0,0,0"
                            ToolTip="Active Ambisonics order and channel count">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OrderDot" Width="7" Height="7"
                                     Fill="{StaticResource AccentBright}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock x:Name="OrderPillText" Text="1st Order · 4 ch"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                            ToolTip="Ambisonics channel layout">
                        <TextBlock Text="AmbiX · ACN/SN3D" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                            ToolTip="Preview monitoring is a UI/state hook in this build">
                        <TextBlock Text="PREVIEW" FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDim}"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                            Background="#12351F" BorderBrush="{StaticResource Success}"
                            ToolTip="AmbiX WAV/W64/FLAC export and stereo/binaural preview are available. IAMF / Eclipsa is planned for Phase D.">
                        <TextBlock Text="AMBIX RENDER READY" FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#86EFAC"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="HeaderPreviewText"
                           Text="Binaural (Headphones)"
                           Foreground="#2DD4BF" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3D soundstage + source position -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="StageCanvas" ClipToBounds="True"
                            Background="#141417"
                            MouseLeftButtonDown="OnStageMouseDown"
                            MouseMove="OnStageMouseMove"
                            MouseLeftButtonUp="OnStageMouseUp"
                            LostMouseCapture="OnStageLostMouseCapture"
                            SizeChanged="OnStageSizeChanged"/>
                    <Border Background="#CC18181B" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="7,2" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="3D SOUNDSTAGE" Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <Border Background="#CC18181B" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="7,2" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="DRAG RADAR · DRAG ELEVATION RAIL"
                                   Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <Border Background="#CC18181B" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="7,2" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="10">
                        <TextBlock x:Name="StageReadoutText"
                                   Text="AZ +0.0° · EL +10.0° · D 0.70"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}"
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource TrackBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11"
                                Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SourceTabButton" GroupName="HoaSideTabs"
                                             Content="SOURCE" IsChecked="True"
                                             Checked="OnHoaSideTabChecked"
                                             Style="{StaticResource HoaSegmentRadio}"/>
                                <RadioButton x:Name="EffectsTabButton" GroupName="HoaSideTabs"
                                             Content="EFFECTS"
                                             Checked="OnHoaSideTabChecked"
                                             Style="{StaticResource HoaSegmentRadio}"/>
                                <RadioButton x:Name="MonitorTabButton" GroupName="HoaSideTabs"
                                             Content="MONITOR"
                                             Checked="OnHoaSideTabChecked"
                                             Style="{StaticResource HoaSegmentRadio}"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="Reset 3D Position"
                                Click="OnResetPositionClicked"
                                Padding="8,2" FontSize="11" Margin="0"
                                ToolTip="Restore the default HOA source position. This never writes 7.1 automation."/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="SourcePanel"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,7">
                                        <TextBlock Text="AZIMUTH" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock x:Name="AzValueText" Text="+0.0°"
                                                   FontFamily="Consolas" FontSize="18"
                                                   Foreground="{StaticResource AccentBright}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,7">
                                        <TextBlock Text="ELEVATION" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock x:Name="ElValueText" Text="+10.0°"
                                                   FontFamily="Consolas" FontSize="18"
                                                   Foreground="{StaticResource AccentBright}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="DISTANCE" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock x:Name="DistValueText" Text="0.70"
                                                   FontFamily="Consolas" FontSize="18"
                                                   Foreground="#2DD4BF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="SPREAD" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock x:Name="SpreadValueText" Text="0.10"
                                                   FontFamily="Consolas" FontSize="18"
                                                   Foreground="#2DD4BF"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderSoft}"
                                        Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Azimuth"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="AzimuthSlider"
                                            Minimum="-180" Maximum="180" Value="0"
                                            SmallChange="0.1" LargeChange="10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnAzimuthSliderChanged"/>
                                    <TextBox Grid.Column="2" x:Name="AzSliderText" Text="0.0"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type an exact azimuth (-180..180) and press Enter"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Elevation"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="ElevationSlider"
                                            Minimum="-90" Maximum="90" Value="10"
                                            SmallChange="0.1" LargeChange="10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnElevationSliderChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ElSliderText" Text="10.0"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type an exact elevation (-90..90) and press Enter"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Distance"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="DistanceSlider"
                                            Minimum="0" Maximum="1" Value="0.70"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnDistanceSliderChanged"/>
                                    <TextBox Grid.Column="2" x:Name="DistSliderText" Text="0.70"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type an exact distance (0.00..1.00) and press Enter"/>
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Spread"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SpreadSlider"
                                            Minimum="0" Maximum="1" Value="0.10"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnSpreadSliderChanged"/>
                                    <TextBox Grid.Column="2" x:Name="SpreadSliderText" Text="0.10"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type an exact spread (0.00..1.00) and press Enter"/>
                                </Grid>

                                <TextBlock Text="Tip: type an exact value in any field and press Enter."
                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="Radar = azimuth/distance; the rail = elevation. At ±90° the source is overhead/floor, not hard right/left."
                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="EffectsPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="DISTANCE &amp; AIR" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="DistanceModelCombo"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="OnDistanceModelChanged"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Air absorption"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="AirSlider"
                                            Minimum="0" Maximum="1" Value="0"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnAirChanged"/>
                                    <TextBox Grid.Column="2" x:Name="AirValueText" Text="0.00"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type an exact air absorption (0.00..1.00) and press Enter"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderSoft}"
                                        Margin="0,0,0,8"/>

                                <TextBlock Text="BINAURAL MONITOR" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Head model"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="HeadModelCombo"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="OnHeadModelChanged"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Head width"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="HeadWidthSlider"
                                            Minimum="0.5" Maximum="1.5" Value="1.0"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnHeadWidthChanged"/>
                                    <TextBox Grid.Column="2" x:Name="HeadWidthValueText" Text="1.00"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type a head width (0.50..1.50) and press Enter"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Room amount"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="RoomAmountSlider"
                                            Minimum="0" Maximum="1" Value="0"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnRoomAmountChanged"/>
                                    <TextBox Grid.Column="2" x:Name="RoomAmountValueText" Text="0.00"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type a room amount (0.00..1.00) and press Enter"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Room size"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="RoomSizeSlider"
                                            Minimum="0" Maximum="1" Value="0.50"
                                            SmallChange="0.01" LargeChange="0.10"
                                            Margin="0,0,8,0"
                                            ValueChanged="OnRoomSizeChanged"/>
                                    <TextBox Grid.Column="2" x:Name="RoomSizeValueText" Text="0.50"
                                             Width="52" Height="22" Padding="2,0"
                                             FontFamily="Consolas" FontSize="11"
                                             TextAlignment="Right" VerticalContentAlignment="Center"
                                             LostFocus="OnHoaNumericFieldLostFocus"
                                             KeyDown="OnHoaNumericFieldKeyDown"
                                             ToolTip="Type a room size (0.00..1.00) and press Enter"/>
                                </Grid>
                                <TextBlock Text="Distance and air absorption apply to the AmbiX master and preview. Head model, width, and room are monitor-only."
                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <Button Content="Reset Effects" Click="OnResetEffectsClicked"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="Reset distance, air, head model/width, and room. Position and order are unchanged."/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="MonitorPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="SCENE" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Preset"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="SourcePresetCombo"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="OnSourcePresetChanged"/>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Snap"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="SnapCombo"
                                              Style="{StaticResource DarkComboBox}"
                                              Margin="0,0,8,0"
                                              SelectionChanged="OnSnapChanged"/>
                                    <Button Grid.Column="2" x:Name="AbButton"
                                            Content="A/B" Click="OnAbClicked"
                                            Padding="10,3" Margin="0,0,8,0"
                                            ToolTip="Store the current state in this slot and recall the other"/>
                                    <TextBlock Grid.Column="3" x:Name="AbStatusText"
                                               Text="ACTIVE A"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderSoft}"
                                        Margin="0,0,0,8"/>

                                <TextBlock Text="OUTPUT METERS" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="L"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" x:Name="HoaLeftMeter"
                                                 Style="{StaticResource GainMeter}"
                                                 Value="0" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" x:Name="HoaLeftDbText"
                                               Text="—"
                                               FontFamily="Consolas" FontSize="11"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="R"
                                               Style="{StaticResource MutedLabel}"
                                               VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" x:Name="HoaRightMeter"
                                                 Style="{StaticResource GainMeter}"
                                                 Value="0" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" x:Name="HoaRightDbText"
                                               Text="—"
                                               FontFamily="Consolas" FontSize="11"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="HoaPeakText"
                                               Text="PEAK —"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" x:Name="HoaCorrelationText"
                                               Text="CORR —"
                                               FontFamily="Consolas" FontSize="11"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                                <TextBlock Text="Meters update after each Preview. Bypass preview is available in the Preview selector."
                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Track routing -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="TRACK ROUTING" Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,7"/>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Source"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" x:Name="SourceModeCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,7,0"
                              SelectionChanged="OnSourceModeChanged"/>
                    <TextBlock Grid.Column="2" x:Name="SourceModeHintText"
                               Text="Selected track only"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Track" Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" x:Name="TrackCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,7,0"
                              SelectionChanged="OnTrackSelectionChanged"/>
                    <Button Grid.Column="2" Content="Refresh Tracks"
                            Click="OnRefreshTracksClicked" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="Reset 3D Position"
                            Click="OnResetPositionClicked" Margin="0"/>
                </Grid>
                <TextBlock Text="HOA positions stay inside this workspace: they are never routed into the [7.1] FL..SR bus sends."
                           Style="{StaticResource MutedLabel}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- HOA encode / delivery -->
        <Border Grid.Row="3" Style="{StaticResource Card}"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="HOA ENCODE &amp; DELIVERY" Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,7"/>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Order"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" x:Name="OrderCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,14,0"
                              SelectionChanged="OnOrderChanged"/>
                    <TextBlock Grid.Column="2" Text="Preview"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="3" x:Name="PreviewCombo"
                              Style="{StaticResource DarkComboBox}"
                              Margin="0,0,14,0"
                              SelectionChanged="OnPreviewChanged"
                              ToolTip="Stereo Downmix uses equal-power L/R panning (hard ±90° is intentionally one-sided). Binaural keeps a shadowed far ear."/>
                    <TextBlock Grid.Column="4" Text="Export"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="5" x:Name="ExportCombo"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="OnExportTargetChanged"
                              ToolTip="HOA AmbiX is exported through the Format selector (WAV, Wave64, FLAC). IAMF / Eclipsa is planned for Phase D."/>
                </Grid>
                <TextBlock x:Name="WeightInfoText"
                           Text="4 ch · ACN/SN3D · Σg² 2.00"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Positions and ACN/SN3D weights are applied to the rendered source stem. The 7.1 bus sends are never used."
                           Foreground="#FCD34D" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output"
                               Style="{StaticResource MutedLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBox Grid.Column="1" x:Name="HoaOutputPathBox"
                             Height="27" Margin="0,0,7,0"
                             TextChanged="OnHoaOutputPathChanged"/>
                    <Button Grid.Column="2" Content="Browse…"
                            Click="OnBrowseHoaOutputClicked" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" x:Name="HoaPreviewButton"
                            Content="Preview (Binaural)"
                            Click="OnHoaPreviewClicked" Margin="0,0,6,0"/>
                    <Button Grid.Column="4" x:Name="HoaExportButton"
                            Content="Export HOA Master"
                            Click="OnHoaExportClicked" Margin="0"
                            Padding="12,4" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock x:Name="HoaRenderStatusText"
                           Text="Choose an output path"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock Text="In/Out loop is used when set (preview is capped at 8 s); otherwise master = full timeline, preview = 8 s from the playhead."
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="WAV = RIFF (≤4 GB) · Wave64 = large-file WAV · FLAC = compressed lossless (≤8 ch)."
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="Preview balance is logged after each render. Hard ±90° Stereo Downmix is intentionally one-sided; Binaural keeps both ears."
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Compact status footer + collapsible diagnostic drawer -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Height="28" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusFooterText"
                               Text="Ready" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="Consolas" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" x:Name="LogToggleButton"
                            Content="▲ Diagnostic"
                            Style="{StaticResource FooterButton}"
                            Click="OnToggleLogClicked"
                            ToolTip="Expand or collapse the shared diagnostic transcript"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" x:Name="LogDrawer" Height="150"
                    Background="#141417" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,4,0,0" Visibility="Collapsed">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#141417" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
