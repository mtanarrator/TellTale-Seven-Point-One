<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VegasSurround71.Phase4BVerification</AssemblyName>
    <RootNamespace>VegasSurround71.Phase4BVerification</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VegasInstallDir Condition="'$(VegasInstallDir)' == ''">C:\Program Files\BorisFX\Vegas Pro 2027</VegasInstallDir>
    <VegasAssembly>$(VegasInstallDir)\ScriptPortal.Vegas.dll</VegasAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vegas_panel\VegasSurround71.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptPortal.Vegas">
      <HintPath>$(VegasAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rust_core\target\release\telltale_7point1_core.dll"
          Link="telltale_7point1_core.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\rust_core\target\release\telltale_7point1_core.dll')" />
  </ItemGroup>

</Project>
